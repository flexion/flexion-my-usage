{
	"name": "@flexion.us/my-usage",
	"version": "0.1.0",
	"description": "Local, offline dashboard for your own AI coding-agent usage and notional cost.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/flexion/flexion-my-usage.git"
	},
	"type": "module",
	"packageManager": "yarn@4.18.0",
	"engines": {
		"node": ">=22.13.0"
	},
	"bin": "./dist/index.js",
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json && vite build --config vite.web.config.ts --logLevel warn",
		"dev": "yarn build && node dist/index.js",
		"typecheck": "tsc --noEmit && tsc -p tsconfig.config.json && tsc -p src/web/tsconfig.json",
		"check:package": "yarn build && tsx scripts/check-package.mjs",
		"lint": "biome check . && sh scripts/check-coverage-pragmas.sh && tsx scripts/check-fixtures-guard.mjs && tsx scripts/check-branch-guard.mjs && tsx scripts/check-renovate-engines.mjs",
		"format": "biome format --write .",
		"test": "vitest run --coverage"
	},
	"dependencies": {
		"undici": "8.10.2"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@testing-library/dom": "10.4.2",
		"@testing-library/react": "16.3.3",
		"@types/node": "22.13.17",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitest/coverage-v8": "5.0.1",
		"jsdom": "30.1.1",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-is": "19.3.0",
		"recharts": "3.10.1",
		"tsx": "4.23.15",
		"typescript": "7.0.2",
		"vite": "8.3.0",
		"vitest": "5.0.1"
	}
}
