
# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
*.gate.lock*

# bd's own JSONL exports (issues, events, interactions) - passive, local-only sidecars, not the
# source of truth (the Dolt DB is). None is gitignored by bd init itself, and any of them can
# materialize without an explicit `bd export` if its config flag turns on - export.auto is a
# live, committed "true" in .beads/config.yaml today (myusage-5yo, myusage-bkr), and
# events-export/audit.enabled are one config change away from the same. A routine `git add -A`
# must never be able to pick any of them up: issues.jsonl alone dumps every bead's full comment
# history, far more than anything meant to reach a public repo. Broad glob on purpose, so a
# future JSONL sidecar bd adds is covered without a follow-up bead every time.
.beads/*.jsonl

# Node / TypeScript
node_modules/
dist/
*.tsbuildinfo

# Yarn (Berry, node-modules linker)
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*

# Test / coverage
coverage/

# IP-leak guardrail: internal-term denylist stays local, never committed (myusage-6d9)
.guardrail/
